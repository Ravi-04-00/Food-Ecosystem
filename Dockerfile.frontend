# ==============================================================================
# Fast Delivery (FD) - Multi-Stage Frontend Production Dockerfile
# Compiles Customer, Restaurant, Delivery Partner, and Admin React Apps
# ==============================================================================

# --- STAGE 1: Build Stage ---
FROM node:20-alpine AS builder

WORKDIR /build

# Copy root workspace and application package manifests
COPY package.json package-lock.json* ./
COPY frontend/customer-app/package.json ./frontend/customer-app/
COPY frontend/restaurant-app/package.json ./frontend/restaurant-app/
COPY frontend/delivery-partner-app/package.json ./frontend/delivery-partner-app/
COPY frontend/admin-app/package.json ./frontend/admin-app/

# Install build dependencies
RUN npm install

# Copy application source codes
COPY frontend ./frontend

# Build all four React production bundles
RUN npm run build:all

# --- STAGE 2: Web Server Stage (Nginx Alpine) ---
FROM nginx:1.27-alpine AS runner

# Remove default nginx welcome page
RUN rm -rf /usr/share/nginx/html/*

# Copy compiled static assets into distinct portal directories
COPY --from=builder /build/frontend/customer-app/dist /usr/share/nginx/html/customer
COPY --from=builder /build/frontend/restaurant-app/dist /usr/share/nginx/html/restaurant
COPY --from=builder /build/frontend/delivery-partner-app/dist /usr/share/nginx/html/delivery
COPY --from=builder /build/frontend/admin-app/dist /usr/share/nginx/html/admin

# Copy custom Nginx configuration
COPY nginx/nginx.conf /etc/nginx/nginx.conf
COPY nginx/conf.d/fastdelivery.conf /etc/nginx/conf.d/default.conf

EXPOSE 80 443

HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
    CMD wget -qO- http://localhost/health || exit 1

CMD ["nginx", "-g", "daemon off;"]

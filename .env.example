# Fast Delivery Platform - Environment Configuration Template
# NOTE: Placeholders only. Replace with secure credentials in deployment. Never commit real keys.

# Django Core
DJANGO_SECRET_KEY=replace-with-a-cryptographically-secure-random-secret-key
DJANGO_DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,api.fastdelivery.com

# PostgreSQL Database Configuration
USE_POSTGRES=True
POSTGRES_DB=fdfood_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# CORS & CSRF Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
CSRF_TRUSTED_ORIGINS=https://customer.fastdelivery.com,https://restaurant.fastdelivery.com,https://delivery.fastdelivery.com,https://admin.fastdelivery.com

# Channels / Redis Layer (Production Multi-worker support)
REDIS_URL=redis://127.0.0.1:6379/1

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_live_replace_with_key_id
RAZORPAY_KEY_SECRET=replace_with_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_signature_secret

# Google Maps API (Live Tracking & Geocoding)
GOOGLE_MAPS_API_KEY=AIzaSy_replace_with_your_google_maps_api_key

# Email Dispatch
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=replace_with_sendgrid_api_key
DEFAULT_FROM_EMAIL=no-reply@fastdelivery.com
